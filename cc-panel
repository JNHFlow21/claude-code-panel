#!/usr/bin/env -S python3 -I
"""cc-panel: a Claude Code status line drawn as an aligned, animated panel.

Claude Code pipes the status-line JSON on stdin. ccstatusline computes most values
(it is called with a generated data-only config); cc-panel adds session timing from
the transcript and lays everything out in a grid. `cc-panel --demo` renders sample data.
"""
import hashlib, json, os, re, select, shutil, subprocess, sys, time, unicodedata, urllib.request
from datetime import datetime

CACHE = os.path.expanduser("~/.cache/cc-panel")
USAGE = os.path.expanduser("~/.cache/ccstatusline/usage.json")
CCSL_VERSION = "2.2.32"
FABLE_EVERY, FABLE_BACKOFF = 900, 1800  # the usage API rate-limits hard: one fetch per window for all sessions
QUOTA_EVERY = 300  # how often the panel may start a background refresh, across all sessions
QUOTA_MAX_BACKOFF = 3600  # a failing or rate-limited source waits twice as long each time, up to this
CONFIG = os.path.expanduser("~/.config/cc-panel/config.json")
COLLAPSED = os.path.join(CACHE, "collapsed")
SPIN = "·✢✳✶✻✽✻✶✳✢"
WIDGETS = [
    ("model", "model", {}), ("effort", "thinking-effort", {}),
    ("ctx", "context-percentage", {"numberFormat": {"style": "whole"}}),
    ("ctxlen", "context-length", {"numberFormat": {"style": "compact"}}),
    ("clock", "session-clock", {}), ("cost", "session-cost", {"numberFormat": {"decimals": 4}}),
    ("cache", "cache-hit-rate", {}), ("speed", "output-speed", {"numberFormat": {"style": "whole"}}),
    ("tokens", "tokens-total", {}), ("sid", "claude-session-id", {}),
]

E = "\x1b["
R, B = E + "0m", E + "1m"
ORANGE, TAN, TEXT, DIM, SUB, GREEN, BLUE, WHITE, EMPTY = (
    "D97757", "D4A27F", "D6D2C4", "87867F", "5E5D59", "9DB07F", "6A9BCC", "FAF9F5", "4A4945")
AMBER, RED, GLOW = "E5B567", "E06C75", "F0A784"
OPENAI, GROK, DEEPSEEK = "10A37F", "FFFFFF", "4D6BFE"  # brand colors


def fg(h):
    return f"{E}38;2;{int(h[:2], 16)};{int(h[2:4], 16)};{int(h[4:], 16)}m"


def width(s):
    s = re.sub(r"\x1b\[[0-9;]*m", "", s)
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pad(s, n):
    return s + " " * (n - width(s))


def lab(t):
    return fg(DIM) + t + R


def val(t, c=WHITE, bold=True):
    return fg(c) + (B if bold else "") + (t or "—") + R


def number(pct):
    m = re.match(r"[\d.]+", pct or "")
    return float(m.group()) if m else 0


def heat(pct, color):
    v = number(pct)
    return RED if v >= 90 else AMBER if v >= 70 else color


def bar(pct, color, n=8):
    v = number(pct)
    k = min(n, max(round(v / 100 * n), 1 if v > 0 else 0))  # any use lights one cell
    return fg(color) + "▰" * k + fg(EMPTY) + "▱" * (n - k) + R


def left(secs):
    secs = int(secs)
    if secs >= 86400:
        return f"{secs // 86400}d{secs % 86400 // 3600}h"
    return f"{secs // 3600}h{secs % 3600 // 60:02d}m" if secs >= 3600 else f"{secs // 60}m{secs % 60:02d}s"


def dur(ms):
    v = round(ms / 1000, 1)
    if v < 60:
        return f"{v:.1f}s"
    v = round(v)
    return f"{v // 60}m{v % 60:02d}s" if v < 3600 else f"{v // 3600}h{v % 3600 // 60:02d}m"


def cache_file(*parts):
    os.makedirs(CACHE, exist_ok=True)
    return os.path.join(CACHE, hashlib.sha1("|".join(map(str, parts)).encode()).hexdigest()[:16])


def write_json(path, data):  # status lines can render concurrently: write atomically
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


# --- values from ccstatusline -------------------------------------------------

def ccstatusline_cmd():
    found = os.environ.get("CC_PANEL_CCSTATUSLINE") or shutil.which("ccstatusline")
    return [found] if found else ["npx", "-y", f"ccstatusline@{CCSL_VERSION}"]


def data_config(widgets=WIDGETS, name="ccstatusline-data.json"):
    line = []
    for i, (_, kind, extra) in enumerate(widgets):
        if i:
            line.append({"type": "custom-text", "customText": "␟", "id": f"s{i}", "merge": "no-padding"})
        line.append({"type": kind, "rawValue": True, "id": f"w{i}", "merge": "no-padding", **extra})
    path = os.path.join(CACHE, name)
    cfg = {"version": 4, "colorLevel": 0, "lines": [line]}
    try:
        if json.load(open(path)) == cfg:
            return path
    except (OSError, ValueError):
        pass
    os.makedirs(CACHE, exist_ok=True)
    write_json(path, cfg)
    return path


def ccstatusline(stdin, j):
    """Recomputed only when the session state changes: one ccstatusline run takes ~1s."""
    cw, rl = j.get("context_window") or {}, j.get("rate_limits") or {}
    key = json.dumps([j.get("model"), j.get("effort"), (j.get("cost") or {}).get("total_cost_usd"),
                      cw.get("total_input_tokens"), cw.get("total_output_tokens"), rl,
                      int(time.time() // 30), [k for k, _, _ in WIDGETS]], sort_keys=True)  # time bucket keeps the clock fresh
    path = cache_file("ccsl", j.get("session_id"))
    try:
        cached = json.load(open(path))
        if cached["key"] == key:
            return cached["out"]
    except (OSError, ValueError, KeyError):
        pass
    try:
        out = subprocess.run(ccstatusline_cmd() + ["--config", data_config()], input=stdin, capture_output=True,
                             text=True, env={**os.environ, "CCSTATUSLINE_WIDTH": "1000"}, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    write_json(path, {"key": key, "out": out})
    return out


# --- session timing from the transcript ---------------------------------------

FRESH = dict(offset=0, tool_ms=0, cur=None, open={}, wait_ms=0, waits=0, waiting_since=None)


def stamp(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp() * 1000


def feed(s, e):
    if e.get("isSidechain") or e.get("type") not in ("user", "assistant") or "timestamp" not in e:
        return
    t, content = stamp(e["timestamp"]), e.get("message", {}).get("content")
    blocks = content if isinstance(content, list) else []
    if e["type"] == "assistant":
        if s["waiting_since"] is not None:
            s["wait_ms"] += t - s["waiting_since"]; s["waits"] += 1
            s["waiting_since"] = None
        for b in blocks:
            if b.get("type") == "tool_use":
                s["open"][b.get("id")] = t
        return
    results = [b for b in blocks if b.get("type") == "tool_result"]
    for b in results:
        start = s["open"].pop(b.get("tool_use_id"), None)
        if start is None:
            continue
        cur = s["cur"]  # merge overlapping [call, result] intervals so parallel tools count once
        if cur and start <= cur[1]:
            cur[1] = max(cur[1], t)
        else:
            if cur:
                s["tool_ms"] += cur[1] - cur[0]
            s["cur"] = [start, t]
    if results and not s["open"]:
        s["waiting_since"] = t
    elif not results and not e.get("isMeta"):  # a human prompt starts a fresh request
        s["open"].clear()
        s["waiting_since"] = t


def timing(path):
    """(average wait until the first written block, tool wall time), scanned incrementally.

    The wait is an upper bound on TTFT: the transcript stamps a block once it is complete.
    """
    if not path or not os.path.exists(path):
        return None, None
    cache = cache_file("timing", path)
    try:
        s = json.load(open(cache))
    except (OSError, ValueError):
        s = dict(FRESH)
    if os.path.getsize(path) < s["offset"]:
        s = dict(FRESH)
    with open(path, "rb") as f:
        f.seek(s["offset"])
        for line in f:
            if not line.endswith(b"\n"):
                break  # partial write; read it next time
            s["offset"] += len(line)
            try:
                feed(s, json.loads(line))
            except (ValueError, KeyError, AttributeError, TypeError):
                pass
    try:
        write_json(cache, s)
    except OSError:
        pass
    tool = s["tool_ms"] + (s["cur"][1] - s["cur"][0] if s["cur"] else 0)
    return (dur(s["wait_ms"] / s["waits"]) if s["waits"] else None), dur(tool)


# --- other subscriptions: Codex, Grok, DeepSeek -------------------------------
# Fetched by a detached `cc-panel --refresh-quotas` at most every QUOTA_EVERY across all sessions;
# the panel itself only reads ~/.cache/cc-panel/quotas.json. Credentials stay in memory.

def codex_quota():
    """Codex's own app-server reports the account's rate limits without spending any."""
    if not shutil.which("codex"):
        return None
    p = subprocess.Popen(["codex", "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True)
    try:
        for m in ({"id": 1, "method": "initialize", "params": {"clientInfo": {"name": "cc-panel", "version": "0.2"}}},
                  {"method": "initialized"}, {"id": 2, "method": "account/rateLimits/read"}):
            p.stdin.write(json.dumps(m) + "\n")
        p.stdin.flush()
        end = time.time() + 20
        while time.time() < end:
            if not select.select([p.stdout], [], [], 1)[0]:
                continue
            line = p.stdout.readline()
            if not line:
                return None
            m = json.loads(line)
            if m.get("id") != 2:
                continue
            res = m.get("result") or {}
            rl = res.get("rateLimits") or {}
            wins = [{"pct": w["usedPercent"], "mins": w.get("windowDurationMins"), "reset": w.get("resetsAt")}
                    for w in (rl.get("primary"), rl.get("secondary")) if w]
            if not wins:
                return None
            rc = res.get("rateLimitResetCredits") or {}
            exp = [c["expiresAt"] for c in rc.get("credits") or [] if c.get("status") == "available" and c.get("expiresAt")]
            return {"windows": wins, "resets": rc.get("availableCount", 0),
                    "reset_expires": min(exp) if exp else None}
    finally:
        p.kill()


def grok_quota():
    """The weekly pool shared by Grok, Grok Build, Grok Bot and Cursor (X subscription), read with
    the Grok CLI's own login. An expired login is left for the Grok CLI to renew."""
    try:
        entry = next(iter(json.load(open(os.path.expanduser("~/.grok/auth.json"))).values()))
        if datetime.fromisoformat(entry["expires_at"].replace("Z", "+00:00")).timestamp() < time.time():
            return None
        req = urllib.request.Request("https://cli-chat-proxy.grok.com/v1/billing?format=credits", headers={
            "authorization": f"Bearer {entry['key']}", "x-xai-token-auth": "xai-grok-cli", "accept": "application/json"})
        c = json.load(urllib.request.urlopen(req, timeout=10))["config"]
    except (OSError, ValueError, KeyError, TypeError, StopIteration, AttributeError):
        return None
    return {"pct": c.get("creditUsagePercent") or 0,  # omitted at the start of a fresh week
            "reset": datetime.fromisoformat(c["billingPeriodEnd"]).timestamp(),
            "products": [[u["product"], u.get("usagePercent", 0)] for u in c.get("productUsage") or []]}


def deepseek_quota():
    """DeepSeek API balance. Needs `deepseek_key_command` in ~/.config/cc-panel/config.json:
    a shell command that writes the API key to file descriptor 3."""
    try:
        cmd = json.load(open(CONFIG))["deepseek_key_command"]
        key = subprocess.run(["sh", "-c", f"{cmd} 3>&1 1>/dev/null 2>/dev/null"], capture_output=True,
                             text=True, timeout=10).stdout.strip()
        if not key:
            return None
        req = urllib.request.Request("https://api.deepseek.com/user/balance",
                                     headers={"Authorization": f"Bearer {key}", "Accept": "application/json"})
        b = json.load(urllib.request.urlopen(req, timeout=10))["balance_infos"][0]
    except (OSError, ValueError, KeyError, TypeError, IndexError, subprocess.TimeoutExpired):
        return None
    return {"total": float(b["total_balance"]), "currency": b["currency"]}


PROVIDERS = (("gpt", codex_quota, 300), ("grok", grok_quota, 600), ("ds", deepseek_quota, 900))


def refresh_quotas():
    """One refresher at a time machine-wide; each source has its own interval and failure backoff."""
    path, lock = os.path.join(CACHE, "quotas.json"), os.path.join(CACHE, "quotas.lock")
    try:
        if time.time() - os.path.getmtime(lock) > 120:  # left behind by a killed refresher
            os.remove(lock)
    except OSError:
        pass
    try:
        fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError:
        return
    try:
        for name, fetch, every in PROVIDERS:
            try:
                s = json.load(open(path))
            except (OSError, ValueError):
                s = {}
            st = s.get(f"{name}_next", {})
            if time.time() < st.get("at", 0):
                continue
            try:
                v = fetch()
            except Exception:
                v = None
            try:
                s = json.load(open(path))
            except (OSError, ValueError):
                s = {}
            if v:
                s[name] = {**v, "ok": time.time()}
                wait = every
            else:  # a failed source keeps its last value
                wait = min(max(st.get("wait", every) * 2, every * 2), QUOTA_MAX_BACKOFF)
            s[f"{name}_next"] = {"at": time.time() + wait, "wait": wait}
            write_json(path, s)
    finally:
        os.close(fd)
        os.remove(lock)


def quotas(now):
    if os.environ.get("CC_PANEL_QUOTAS") == "0":
        return {}
    path = os.path.join(CACHE, "quotas.json")
    try:
        s = json.load(open(path))
    except (OSError, ValueError):
        s = {}
    if now - s.get("tried", 0) >= QUOTA_EVERY:
        s["tried"] = now
        write_json(path, s)  # claim the window first so other sessions skip it
        subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "--refresh-quotas"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    return s


