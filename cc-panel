def demo():
    now = time.time()
    j = {"session_id": "3f2a9c1e-7b4d-4e8a-9c21-5d6e0f1a2b3c",
         "prompt_cache": {"expires_at": now + 3200 - now % 60},
         "rate_limits": {"seven_day": {"resets_at": now + 190000}}}
    d = dict(model="Opus 5.5", effort="high", ctx="38%", ctxlen="380k", week="23%", fable="81%",
             clock="42m", cost="$3.8217", cache="98.7%", speed="182 t/s", tokens="12.4M", sid=j["session_id"])
    q = {"gpt": {"windows": [{"pct": 31, "mins": 10080, "reset": now + 420000}], "resets": 2,
                 "reset_expires": now + 900000, "ok": now},
         "grok": {"pct": 8, "reset": now + 460000, "ok": now,
