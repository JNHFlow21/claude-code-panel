def quota_rows(q, now):
    """One row per other subscription: (brand, fresh, name, (label, main value), secondary text)."""
    rows = []
    every = {name: e for name, _, e in PROVIDERS}

    def gauge(pct, brand, resets_at):
        color = heat(f"{pct}%", brand)
        tail = f" {lab('↻')}{fg(TEXT)}{left(resets_at - now)}{R}" if resets_at and resets_at > now else ""
        return f"{bar(f'{pct}%', color)} {val(f'{round(pct)}%'.rjust(4), color)}{tail}"

    span = lambda mins: "5H" if mins == 300 else "WK" if mins == 10080 else f"{mins // 60}H"
    if v := q.get("gpt"):
        wins = sorted(v["windows"], key=lambda w: w.get("mins") or 0)
        n = v.get("resets") or 0
        extra = [f"{lab(span(w.get('mins') or 0))} {val(str(round(w['pct'])) + '%', TEXT, False)}"
                 for w in wins[:-1]]
        extra.append(f"{lab('RESET')} {val(str(n), OPENAI if n else TEXT, bool(n))}")
        if n and v.get("reset_expires"):
            extra.append(f"{lab('first expires in')} {val(left(v['reset_expires'] - now), TEXT, False)}")
        rows.append((OPENAI, v, "GPT", (span(wins[-1].get("mins") or 0),
                     gauge(wins[-1]["pct"], OPENAI, wins[-1].get("reset"))), f" {fg(SUB)}·{R} ".join(extra)))
    if v := q.get("grok"):
        alias = {"GrokBot": "Bot", "GrokBuild": "Build", "Api": "API"}
        split = f" {fg(SUB)}·{R} ".join(f"{lab(alias.get(p, p))} {val(f'{round(u)}%', TEXT, False)}"
                                     for p, u in v.get("products") or [])
        rows.append((GROK, v, "Grok", ("WK", gauge(v["pct"], GROK, v.get("reset"))), split))
    if v := q.get("ds"):
        sym = {"CNY": "¥", "USD": "$"}.get(v.get("currency"), "")
        total = v["total"]
        color = RED if total < 5 else AMBER if total < 20 else DEEPSEEK
        rows.append((DEEPSEEK, v, "DeepSeek", ("BAL", val(f"{sym}{total:.2f}", color)), ""))
    out = []
    for name, (brand, v, *cells) in zip([k for k in ("gpt", "grok", "ds") if q.get(k)], rows):
        fresh = now - v.get("ok", 0) < 3 * every[name] + 60
        out.append((brand if fresh else DIM, fresh, *cells))
    return out


def render(j, d, first, tool, busy, fable_at, now, q=None, collapsed=False):
    tick = int(now)
    star = SPIN[tick % len(SPIN)] if busy else "✻"
    side = fg(GLOW if busy and tick % 2 else ORANGE) + "▌" + R

    def gauge(pct, color, extra=""):
        color, shown = heat(pct, color), (pct or "—").rjust(4)
        return f"{bar(pct, color)} {val(shown, color)}{extra}"

    def limit(key, resets_at):
        tail = f" {lab('↻')}{fg(TEXT)}{left(resets_at - now)}{R}" if resets_at and resets_at > now else ""
        return gauge(d[key], DIM if key in d.get("stale", ()) else WHITE, tail)

    ttl = ""
    expires = (j.get("prompt_cache") or {}).get("expires_at")
    if expires:
        rest = expires - now
        ttl = val(left(rest), GREEN if rest > 600 else AMBER if rest > 120 else RED) if rest > 0 else val("cold", RED)
    rl = j.get("rate_limits") or {}

    # top-left block: model/cost and effort/clock in two aligned sub-columns
    mw = max(width(d["model"]), width(d["cost"]))
    head = [f"{fg(ORANGE)}{star} {B}{pad(d['model'], mw)}{R} {fg(TAN)}{d['effort']}{R}",
            f"  {val(pad(d['cost'], mw), GREEN)} {val(d['clock'])}", ""]

    # each column: three rows of (label, value); the ID cell may overflow to the right
    cols = [
        [("", h) for h in head],
        [("CTX", gauge(d["ctx"], TAN, f" {lab(d['ctxlen'])}")), ("CACHE", val(d["cache"], GREEN)),
         ("TTL" if ttl else "", ttl)],
        [("WK", limit("week", (rl.get("seven_day") or {}).get("resets_at"))),
         ("FABLE", limit("fable", fable_at)), ("", "")],
        [("OUT", val(d["speed"], BLUE)), ("TTFT", val(first)), ("TOOL", val(tool))],
        [("TOK", val(d["tokens"])), ("ID", fg(SUB) + d["sid"] + R), ("", "")],
    ]
    rows, starts, lws = [[], [], []], [], []
    for col in cols:
        starts.append(sum(width(c) + 3 for c in rows[0]))
        lw = max(width(l) for l, _ in col)
        lws.append(lw)
        cells = [(pad(lab(l), lw) + " " if lw and (l or v) else "") + v for l, v in col]
        cw = max(width(c) for c, (l, _) in zip(cells, col) if l != "ID")
        for r, c in zip(rows, cells):
            r.append(pad(c, cw))
    lines = [f"{side}  " + "   ".join(r).rstrip() for r in rows]

    # other subscriptions: a block below a hairline, one row each with its own brand rail, on the same grid
    others = [] if collapsed else quota_rows(q or {}, now)
    if others:
        lines.append("   " + fg(EMPTY) + "─" * (max(width(l) for l in lines) - 3) + R)
    # the name sits under the model and the main value under CTX; the secondary text gets its own column
    mains = [pad(f"{fg(brand)}{B}●{R} {fg(brand)}{B}{name}{R}", starts[1]) + pad(lab(l), lws[1]) + " " + v
             for brand, _, name, (l, v), _ in others]
    second = max((width(m) for m in mains), default=0) + 3
    for (brand, fresh, *_, text), main in zip(others, mains):
        line = (pad(main, second) + text if text else main).rstrip()
        if not fresh:
            line = fg(DIM) + re.sub(r"\x1b\[[0-9;]*m", "", line) + R
        lines.append(f"{fg(brand)}▌{R}  " + line)
    return "\n".join(lines)


def read_fable():
    try:
        return json.load(open(os.path.join(CACHE, "fable.json")))
    except (OSError, ValueError):
        return {}


def fable_usage(now):
    """Fable weekly usage is the one value Claude Code does not pass in, so it needs the usage API.
    A detached `cc-panel --refresh-fable` fetches it at most once per FABLE_EVERY across all sessions:
    the fetch outlasts the 1 s refresh, and Claude Code kills a status line that is still running."""
    s = read_fable()
    if now - s.get("tried", 0) >= s.get("wait", FABLE_EVERY):
        s["tried"] = now
        write_json(os.path.join(CACHE, "fable.json"), s)  # claim the window first so other sessions skip it
        subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "--refresh-fable"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    return s.get("pct"), now - s.get("ok", 0) > 2 * FABLE_BACKOFF


def refresh_fable():
    cfg = data_config([("fable", "fable-weekly-usage", {"numberFormat": {"style": "whole"}})], "ccstatusline-fable.json")
    try:
        out = subprocess.run(ccstatusline_cmd() + ["--config", cfg], input="{}", capture_output=True,
                             text=True, env={**os.environ, "CCSTATUSLINE_WIDTH": "1000"}, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    out = re.sub(r"\x1b\[[0-9;]*m", "", out).strip()
    s = read_fable()
    if re.fullmatch(r"[\d.]+%", out):
        s.update(pct=out, ok=time.time(), wait=FABLE_EVERY)
    else:
        s["wait"] = FABLE_BACKOFF
    write_json(os.path.join(CACHE, "fable.json"), s)


def compact_window(j):
    """The auto-compact window Claude Code enforces: env first, then local > project > user settings."""
    env = os.environ.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW")
    if env and env.isdigit():
        return int(env)
    root = (j.get("workspace") or {}).get("project_dir") or j.get("cwd") or ""
    for path in (os.path.join(root, ".claude", "settings.local.json"), os.path.join(root, ".claude", "settings.json"),
                 os.path.expanduser("~/.claude/settings.json")):
        try:
            v = json.load(open(path)).get("autoCompactWindow")
        except (OSError, ValueError, AttributeError):
            continue
        if isinstance(v, int) and v > 0:
            return v
    return None


def ctx_value(d, j):
    """CTX is measured against the auto-compact window, so 100% means compaction is due."""
    cw = j.get("context_window") or {}
    u, size = cw.get("current_usage"), cw.get("context_window_size")
    if not isinstance(u, dict) or not isinstance(size, (int, float)) or size <= 0:
        return
    used = sum(u.get(k) or 0 for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
    window = min(size, compact_window(j) or size)
    d["ctx"] = f"{min(round(used / window * 100), 100)}%"


def usage_values(d, j, usage):
    """WK comes straight from Claude Code's rate_limits (no API call); a session that has not
    sent a request yet lacks them, so it shows the last cached value greyed out."""
    rl, d["stale"] = j.get("rate_limits") or {}, set()
    for key, live, field in (("week", "seven_day", "weeklyUsage"),):
        pct = (rl.get(live) or {}).get("used_percentage")
        if pct is None and isinstance(usage.get(field), (int, float)):
            pct = usage[field]
            d["stale"].add(key)
        d[key] = "" if pct is None else f"{round(pct)}%"
    d["fable"], old = fable_usage(time.time())
    if not d["fable"] and isinstance(usage.get("fableUsage"), (int, float)):
        d["fable"], old = f"{round(usage['fableUsage'])}%", True
    if old:
        d["stale"].add("fable")
    d["fable"] = d["fable"] or ""


def main():
    now = time.time()
    if "--refresh-quotas" in sys.argv:
        refresh_quotas()
        return
    if "--refresh-fable" in sys.argv:
        refresh_fable()
        return
    if "--toggle" in sys.argv:  # bind to a hotkey: show or hide the other-subscription rows
        if os.path.exists(COLLAPSED):
            os.remove(COLLAPSED)
        else:
            os.makedirs(CACHE, exist_ok=True)
            open(COLLAPSED, "w").close()
        return
    collapsed = os.path.exists(COLLAPSED) or "--collapsed" in sys.argv
    if "--demo" in sys.argv:
        j, d, (first, tool), busy, fable_at, q = demo()
        print(render(j, d, first, tool, busy, fable_at, now, q, collapsed))
        return
    stdin = sys.stdin.read()
    try:
        j = json.loads(stdin)
    except ValueError:
        j = {}
    parts = re.sub(r"\x1b\[[0-9;]*m", "", ccstatusline(stdin, j)).strip().split("␟")
    d = {k: v.strip() for (k, _, _), v in zip(WIDGETS, parts + [""] * len(WIDGETS))}
    first, tool = timing(j.get("transcript_path"))
    try:  # the transcript is written while Claude works
        busy = now - os.path.getmtime(j.get("transcript_path") or "") < 4
    except OSError:
        busy = False
    try:
        usage = json.load(open(USAGE))
    except (OSError, ValueError):
        usage = {}
    try:
        fable_at = datetime.fromisoformat(usage["fableResetAt"]).timestamp()
    except (ValueError, KeyError, TypeError):
        fable_at = None
    ctx_value(d, j)
    usage_values(d, j, usage)
    print(render(j, d, first, tool, busy, fable_at, now, {} if collapsed else quotas(now), collapsed))


if __name__ == "__main__":
    main()
